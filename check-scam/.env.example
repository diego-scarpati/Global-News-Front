# ─── RPC Endpoints ───────────────────────────────────────────────────────────
# Register at https://alchemy.com and create a BNB Chain app
BSC_WS_URL=wss://bnb-mainnet.g.alchemy.com/v2/YOUR_API_KEY
BSC_HTTP_URL=https://bnb-mainnet.g.alchemy.com/v2/YOUR_API_KEY

SOL_WS_URL=wss://api.mainnet-beta.solana.com
SOL_HTTP_URL=https://api.mainnet-beta.solana.com

# ─── Wallets ─────────────────────────────────────────────────────────────────
# NEVER use your main wallet. Create dedicated wallets for the bot.
# BSC: MetaMask → Account Details → Export Private Key
PRIVATE_KEY_BSC=0x...
# SOL: Phantom → Settings → Export Private Key (base58)
PRIVATE_KEY_SOL=...

# ─── Network ─────────────────────────────────────────────────────────────────
# BOTH | BSC | SOL
NETWORK=BOTH

# ─── Strategy ────────────────────────────────────────────────────────────────
DRY_RUN=true           # true = no real money. ALWAYS start here.
MIN_SCORE=65           # Minimum score to enter (0-100)
TRADE_SIZE_USD=20      # USD per trade (start small)
TAKE_PROFIT_PCT=80     # TP stage 2 — sell remaining 50% at this gain
STOP_LOSS_PCT=30       # Total stop loss %
MAX_OPEN_TRADES=3      # Maximum simultaneous positions
MAX_HOLD_SECONDS=300   # Exit if held longer than 5 minutes
MAX_SLIPPAGE_PCT=15    # Maximum accepted slippage
GAS_PRIORITY_GWEI=5    # Extra BSC gas to beat other bots
MIN_LIQUIDITY_USD=5000 # Minimum pair liquidity
MAX_TOKEN_AGE_MINUTES=10  # Only consider recent tokens
MAX_TOP_HOLDER_PCT=40  # Max % held by top holder

# ─── Telegram Monitor (optional but recommended) ──────────────────────────────
# Get from https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=      # Auto-generated on first run

# ─── Telegram Notifications (optional) ───────────────────────────────────────
# Get TELEGRAM_TOKEN from @BotFather → /newbot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Private TX (optional, anti-MEV) ─────────────────────────────────────────
# 48Club / BlockRazor endpoint for BSC private transactions
PRIVATE_TX_BSC_URL=https://rpc.48club.io
# Jito tip account for Solana bundles
JITO_TIP_ACCOUNT=96gYZGLnJYVFmbjzopPSU6QiEV5fGqZNyN9nmNhvrZU5
