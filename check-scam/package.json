    "input": "^1.0.1",
    "node-telegram-bot-api": "^0.66.0",
    "telegram": "^2.26.14",
    "winston": "^3.14.2"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=18.0.0"
  },
